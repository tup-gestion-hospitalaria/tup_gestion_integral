{
  "name": "gestion-hospitalaria-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:windows": "node --use-system-ca --watch src/server.js",
    "start": "node src/server.js",
    "start:windows": "node --use-system-ca src/server.js",
    "test": "node --test test/api.test.js test/users.test.js test/referrals.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/firebase-emulators.test.js test/integration/referrals-emulator.test.js test/integration/referrals-persistence.test.js",
    "test:emulators": "firebase emulators:exec --config ../firebase.json --project demo-tup-gestion-integral --only auth,firestore \"npm run test:integration\"",
    "emulators:start": "firebase emulators:start --config ../firebase.json --project demo-tup-gestion-integral --only auth,firestore",
    "emulators:seed": "node scripts/seed-emulators.js",
    "emulators:dev": "firebase emulators:exec --config ../firebase.json --project demo-tup-gestion-integral --only auth,firestore --ui \"npm run emulators:seed && npm run dev\"",
    "lint": "eslint .",
    "build": "node scripts/check-syntax.mjs",
    "smoke": "node scripts/smoke-health.mjs",
    "role:set": "node scripts/set-user-role.js"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "^5.1.0",
    "firebase-admin": "^14.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.34.0",
    "globals": "^16.0.0"
  }
}
